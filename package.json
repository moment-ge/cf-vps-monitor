{
  "name": "cf-vps-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "db:remote": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "deploy": "npm run check && npm run build && wrangler deploy --config wrangler.jsonc",
    "preview": "wrangler dev --port 8787 --config wrangler.jsonc",
    "setup:local": "node scripts/setup-local.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "build:agent": "node scripts/build-agent.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-select": "^2.3.7",
    "lucide-react": "^0.577.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.180.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "6.0.2",
    "fflate": "^0.8.3",
    "jsonc-parser": "^3.3.1",
    "miniflare": "4.20260515.0",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
